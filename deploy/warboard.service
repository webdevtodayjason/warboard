[Unit]
Description=WARBOARD API + UI server (:8811)
Documentation=https://warboard.semfreak.dev
After=network-online.target
Wants=network-online.target
# Runs a week unattended: never let systemd give up after a burst of restarts.
StartLimitIntervalSec=0

[Service]
Type=simple
User=warboard
Group=warboard
WorkingDirectory=/opt/warboard
EnvironmentFile=/etc/warboard.env
# Without this python buffers stdout when not a tty and journald shows nothing for minutes.
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/warboard/server.py
Restart=always
RestartSec=5
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal
SyslogIdentifier=warboard
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
# "full" (not "strict") keeps /opt writable for the sqlite WAL sidecar files.
ProtectSystem=full

[Install]
WantedBy=multi-user.target
